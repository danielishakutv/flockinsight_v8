# ── FlockInsight production env ──────────────────────────────
# Copy to `.env` on the server and fill in real values.
# Do NOT commit the real .env.

# PostgreSQL (local on the VPS). Create the role/db first (see DEPLOY.md).
DATABASE_URL="postgresql://flockinsight:CHANGE_DB_PASSWORD@localhost:5432/flockinsight"

# Better Auth — generate once: openssl rand -base64 32
BETTER_AUTH_SECRET="CHANGE_ME_LONG_RANDOM_SECRET"

# Your public HTTPS URL (drives secure cookies + trusted origins).
BETTER_AUTH_URL="https://flockinsight.yourdomain.com"
NEXT_PUBLIC_APP_URL="https://flockinsight.yourdomain.com"

# Port the Node app listens on (must match ecosystem.config.cjs + Apache proxy).
PORT="3001"
