# $APP_ROOT/shared/deploy.env — build-time settings, sourced by deploy.sh.
#
# Lives in shared/ rather than in the repo because deploy.sh normally runs as
# current/deploy/deploy.sh: the copy from the release that is already live. A
# default changed in git does not reach the build until the deploy AFTER the
# one you are running. Anything set here applies to the very next build.
#
#   cp deploy/deploy.env.example $APP_ROOT/shared/deploy.env

# How much heap the build may use.
#
# The TypeScript pass at the end of `next build` is what needs this; it
# outgrew 1024 and died with "Ineffective mark-compacts near heap limit"
# AFTER printing "Compiled successfully", which reads like the build worked.
#
# Size it against `free -h`, not against total RAM. This box runs every site
# we have; a ceiling above what is actually free does not make the build
# succeed, it makes the build take the machine down with it.
NODE_OPTIONS="--max-old-space-size=2048"

# Uncomment to skip the TypeScript pass during the build.
#
# It is the only phase that runs out of memory, and it is duplicated work:
# `pnpm exec tsc --noEmit` runs before every commit. Turning it off here makes
# the build markedly lighter and faster — at the cost of the last safety net
# if something is ever pushed without that check. Off by default; the net is
# worth more than the minutes.
# SKIP_TYPE_CHECK=1
