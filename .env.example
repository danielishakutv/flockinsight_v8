# ─────────────────────────────────────────────────────────────
# FlockInsight environment variables
# Copy this file to `.env` and fill in real values.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection (local dev)
DATABASE_URL="postgresql://postgres:flockinsight@localhost:5432/flockinsight"

# Better Auth — secret used to sign sessions/tokens.
# Generate a new one for production: `openssl rand -base64 32`
BETTER_AUTH_SECRET="change-me-in-production-please-generate-a-real-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Public base URL of the app (used by the client)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Transactional email (password reset + verification) ──
# Preferred: Resend API. EMAIL_FROM must be a verified Resend sender/domain.
RESEND_API_KEY=""
EMAIL_FROM="FlockInsight <no-reply@flockinsight.com>"
# Fallback only (used when RESEND_API_KEY is empty): SMTP.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
# Set to "true" (with email configured) to require verification on signup.
REQUIRE_EMAIL_VERIFICATION="false"

# ── SMS for the follow-up team (Kudisms — https://my.kudisms.net) ──
# Leave blank to disable in-app SMS sending.
KUDISMS_API_TOKEN=""
KUDISMS_SENDER_ID=""
# Route/gateway id from your Kudisms dashboard (optional; defaults to "2").
KUDISMS_GATEWAY="2"

# ── Media uploads (Cloudinary — https://cloudinary.com) ──
# Required to enable the Media library, sermons, member photos, logos etc.
# Find these in your Cloudinary dashboard (Account Details). Leave blank to
# disable uploads. Images & video are optimised/resized on upload to save space.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Scheduled jobs (cron) ──
# Shared secret guarding the /api/cron/* endpoints (?key=... or Bearer header).
# Storage add-on renewal (daily) + scheduled devotionals/newsletters (every few min):
#   curl -s "$BETTER_AUTH_URL/api/cron/storage?key=$CRON_SECRET"
#   curl -s "$BETTER_AUTH_URL/api/cron/devotionals?key=$CRON_SECRET"
# The daily reminders cron also runs the first-timer sequence, OTP purge and
# analytics pruning — no extra crontab entry needed:
#   curl -s "$BETTER_AUTH_URL/api/cron/reminders?key=$CRON_SECRET"
# Meeting housekeeping (every 10 min) closes rooms whose last participant
# vanished and sweeps the signalling buffer:
#   curl -s "$BETTER_AUTH_URL/api/cron/meetings?key=$CRON_SECRET"
CRON_SECRET=""

# ── Product analytics (PostHog) ──
# OPTIONAL. Leave blank to disable PostHog entirely (nothing loads). Create a
# free project at posthog.com (choose the EU region for data residency), then:
#   NEXT_PUBLIC_POSTHOG_KEY   = your project API key (phc_...)
#   NEXT_PUBLIC_POSTHOG_HOST  = https://eu.i.posthog.com  (or https://us.i.posthog.com)
# These are inlined at BUILD time, so rebuild after setting them.
# The first-party /superadmin/usage dashboard works WITHOUT PostHog.
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"

# ---- Roadmap feed -------------------------------------------------
# GET /api/roadmap returns items ticked "public" to anyone, with no
# metrics. Supplying this key (?key=..., `x-roadmap-key`, or
# `Authorization: Bearer`) returns EVERYTHING: specs, priorities and the
# platform-size snapshot frozen onto each shipped item. A signed-in
# superadmin gets the full feed without it.
# Leave unset and there is no key route at all.
ROADMAP_FEED_KEY=

# ---- Email: ZeptoMail (Zoho) --------------------------------------
# The provider is chosen by which key is present, in this order:
#   ZEPTOMAIL_TOKEN  ->  RESEND_API_KEY  ->  SMTP_HOST
# So switching provider is an env change and a restart, and leaving the
# old key in place keeps a fallback while the new one is proven.
#
# Send Mail Token from the ZeptoMail console (Mail Agents -> your agent ->
# SMTP & API -> Send Mail Token). Paste it with or without the
# "Zoho-enczapikey " prefix; both are accepted.
# Read by the app and, on the server, by deploy/server-watchdog.sh — it
# takes this same token from shared/.env so alerting cannot drift out of
# step with the app when the token is rotated.
ZEPTOMAIL_TOKEN=
# Only if your account is on the EU datacentre:
#   https://api.zeptomail.eu/v1.1/email
ZEPTOMAIL_API_URL=
# Any long random string. Append it to the webhook URL you register in the
# ZeptoMail console as ?key=... — delivery reports are ignored without it.
ZEPTOMAIL_WEBHOOK_SECRET=

# EMAIL_FROM must be on a domain verified in ZeptoMail, or every send is
# rejected. Only the display name ever changes per church; the address does not.

# ---- Virtual meetings: STUN and TURN ------------------------------
# Meetings connect browsers directly to each other. STUN tells a browser
# its own public address, which is enough on most home and office
# connections — the defaults below are public servers and need no setup.
#
# It is NOT enough on a Nigerian mobile network. Carrier-grade NAT puts
# thousands of subscribers behind one address and rewrites ports, so two
# phones on mobile data frequently cannot reach each other at all. A TURN
# server relays the media in that case.
#
# Without TURN, roughly 10-20% of pairs fail to connect, and to the people
# it happens to it looks random. If meetings matter to your churches, run
# a TURN server (coturn) and set it here.
#
#   sudo apt install coturn
#   /etc/turnserver.conf:
#     listening-port=3478
#     tls-listening-port=5349
#     fingerprint
#     use-auth-secret
#     static-auth-secret=<the same value as TURN_STATIC_AUTH_SECRET>
#     realm=meet.yourdomain.com
#     no-multicast-peers
#     cert=/etc/letsencrypt/live/meet.yourdomain.com/fullchain.pem
#     pkey=/etc/letsencrypt/live/meet.yourdomain.com/privkey.pem
#   Open UDP+TCP 3478 and 5349, and UDP 49152-65535 for the relay range.
#
# Comma-separated. Include the TLS (turns:) entry — it is what gets
# through a restrictive corporate or campus firewall.
# EASIEST: Cloudflare Realtime TURN. Nothing to run and nothing to patch, it
# listens on 443/TCP and 443/UDP (which is what gets through a corporate or
# campus firewall that blocks 3478), and its relays are anycast so they sit
# close to whoever is calling. Free alongside Cloudflare's SFU, otherwise
# $0.05/GB with the first 1,000 GB free — for reference, an hour of relayed
# audio is roughly 20 MB and an hour of relayed video about 500 MB, and only
# the pairs that CANNOT connect directly ever touch it.
#
# Create a TURN key at Cloudflare dashboard -> Realtime -> TURN, then set both:
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
#
# OR run your own coturn and set these instead. The two are not combined: if
# the Cloudflare pair is set it wins, and these are the fallback.
TURN_URLS=
# Preferred: coturn's `static-auth-secret`. Credentials are then minted per
# request and expire after two hours, so one lifted from a browser is not a
# free relay for ever.
TURN_STATIC_AUTH_SECRET=
# Simpler, and less safe: a fixed username and password. Used only when no
# static secret is set.
TURN_USERNAME=
TURN_PASSWORD=
# Override the public STUN list if you run your own. Comma-separated.
STUN_URLS=
# Set to "true" to force EVERY connection through the relay. Only for
# checking that TURN really works — it makes every call cost relay
# bandwidth, so turn it off again.
TURN_ONLY=
